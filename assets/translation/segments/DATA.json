   "lines": [
    {
     "id": "DATA/STS_0@0#0",
     "flags": 7,
     "ko": "　풀 리페어 키트　＜아이템＞\n사용하면 내구력을 최대까지\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#1",
     "flags": 7,
     "ko": "　하이 리페어 키트　＜아이템＞\n사용하면 내구력을 １０００\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#2",
     "flags": 7,
     "ko": "　리페어 키트　＜아이템＞\n사용하면 내구력을 ２００\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#3",
     "flags": 7,
     "ko": "　통조림　＜아이템＞\n사용하면 내구력을 ３００\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#4",
     "flags": 7,
     "ko": "　플라즈마 맥시마　＜아이템＞\n사용하면 플라즈마를 최대까지\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#5",
     "flags": 7,
     "ko": "　플라즈마 하프　＜아이템＞\n사용하면 플라즈마를 ２００\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#6",
     "flags": 7,
     "ko": "　플라즈마 서플라이　＜아이템＞\n사용하면 플라즈마를 １００\n회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#7",
     "flags": 7,
     "ko": "　인공심장　＜아이템＞\n사용하면 내구력과 플라즈마를\n최대까지 회복할 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#8",
     "flags": 7,
     "ko": "　구운 푸딩　＜아이템＞\n먹으면 맛있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#9",
     "flags": 7,
     "ko": "　보디 플레이트　＜아이템＞\n사용하면 갈리 보디의\n최대 내구력을 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#10",
     "flags": 7,
     "ko": "　파워 칩　＜아이템＞\n사용하면 갈리 보디의\n공격력을 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#11",
     "flags": 7,
     "ko": "　가드 칩　＜아이템＞\n사용하면 갈리 보디의\n방어력을 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#12",
     "flags": 7,
     "ko": "　팔라듐 큐브　＜아이템＞\n효과는 없지만 고가품이라\n상점에 비싸게 팔 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#13",
     "flags": 7,
     "ko": "　１０기가바이트ＤＲＡＭ　＜아이템＞\n효과는 없지만 고가품이라\n상점에 비싸게 팔 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#14",
     "flags": 7,
     "ko": "　갈에데 블레이드　＜무기＞\n갈에데가 맡긴 황금빛\n최강의 다마스쿠스 블레이드.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#15",
     "flags": 7,
     "ko": "　뉴 다마스쿠스 블레이드　＜무기＞\n나노머신으로 재구성된\n강력한 블레이드.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#16",
     "flags": 7,
     "ko": "　팔터 블레이드　＜무기＞\n나비식 긴 자루가 달린\n양손용의 예리한 블레이드.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#17",
     "flags": 7,
     "ko": "　세라믹 나이프　＜무기＞\n외날 비금속제 나이프. 오래 써도\n녹슬지 않아 날이 안 무뎌진다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#18",
     "flags": 7,
     "ko": "　컴뱃 나이프　＜무기＞\n원래 군용으로 쓰이던 실전적인\n나이프. 외날에 디자인도 심플하다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#19",
     "flags": 7,
     "ko": "　서바이벌 나이프　＜무기＞\n날끝이 잘게 톱니 모양으로 된\n예리한 외날 나이프.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#20",
     "flags": 7,
     "ko": "　보위 나이프　＜무기＞\n외날에 날 길이 ２５센티.\n큰 나이프.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#21",
     "flags": 7,
     "ko": "　Ｂ다마스쿠스 블레이드　＜무기＞\n나비식 긴 자루가 달린\n양손용 다마스쿠스 블레이드.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#22",
     "flags": 7,
     "ko": "　오스도그 블레이드　＜무기＞\n다마스쿠스강으로 단련한 블레이드.\n에드의 보디가 재료로 쓰였다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#23",
     "flags": 7,
     "ko": "　다마스쿠스 블레이드　＜무기＞\n다마스쿠스강으로 단련한 블레이드.\n고철마을의 고철이 재료로 쓰였다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#24",
     "flags": 7,
     "ko": "　쿠크리 나이프　＜무기＞\n특수 형태의 외날 나이프.\n날 길이 ３０센티의 대형.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#25",
     "flags": 7,
     "ko": "　아세이미 나이프　＜무기＞\n１８센티 외날 나이프.\n스테인리스제라 가볍다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#26",
     "flags": 7,
     "ko": "　대거　＜무기＞\n２０센티 양날 단검.\n오랜 역사를 지닌 무기.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#27",
     "flags": 7,
     "ko": "　버서커 건　＜원거리（총기）＞\n버서커 세포로 만들어진 총.\n특히 버서커 짐승에게 효과가 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#28",
     "flags": 7,
     "ko": "　버서커 건 탄환　＜원거리＞\n버서커 건 전용 탄환.\n버서커 건에 자동 장전된다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#29",
     "flags": 7,
     "ko": "　ＴＵＮＥＤ 건　＜원거리（총기）＞\n１０밀리 구경 대형 머신건 피스톨.\nＴＵＮＥＤ 장비.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#30",
     "flags": 7,
     "ko": "　ＴＵＮＥＤ 건 탄환　＜원거리＞\nＴＵＮＥＤ 건 전용 탄환.\nＴＵＮＥＤ 건에 자동 장전.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#31",
     "flags": 7,
     "ko": "　폭음탄　＜원거리＞\n３발을 동시에 쏘는 화염 속성 무기.\n폭발로 주변 적까지 휘말리게 한다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#32",
     "flags": 7,
     "ko": "　수리검　＜원거리＞\n직접 대미지를 주는 무속성 무기.\n５방향으로 던진다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#33",
     "flags": 7,
     "ko": "　엔케라　＜원거리＞\nＴＵＮＥＤ 장비. 플라즈마 속성 무기.\n폭발로 주변 적까지 휘말리게 한다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#34",
     "flags": 7,
     "ko": "　미사일 비　＜원거리＞\nＴＵＮＥＤ 장비. 적을 호밍하며\n다중 록온이 가능한 벌 모양 미사일.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#35",
     "flags": 7,
     "ko": "　에레키 텔　＜원거리＞\n전기 속성 무기. 적에게 맞으면 폭발해\n근처의 적까지 휘말리게 한다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#36",
     "flags": 7,
     "ko": "　전자 니들　＜원거리＞\n３발 동시 발사. 전기 속성으로\n사이버네계 적에게 효과적.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#37",
     "flags": 7,
     "ko": "　화염병　＜원거리＞\n화염 속성 무기.\n뮤턴트계 적에게 효과적.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#38",
     "flags": 7,
     "ko": "　커맨드 파츠　＜파츠＞\n장착하면 타격계 기술의 공격력을\n조금 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#39",
     "flags": 7,
     "ko": "　쇼크 업소버　＜파츠＞\n장착하면 갈리의 방어력을\n조금 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#40",
     "flags": 7,
     "ko": "　제너레이터 유닛　＜파츠＞\n장착하면 최대 내구력을\n조금 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#41",
     "flags": 7,
     "ko": "　플라즈마 서브 유닛　＜파츠＞\n장착하면 플라즈마 소비량을\n조금 줄일 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#42",
     "flags": 7,
     "ko": "　플라즈마 유닛　＜파츠＞\n장착하면 플라즈마 소비량을\n크게 줄일 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#43",
     "flags": 7,
     "ko": "　클리어 사이트　＜파츠＞\n장착하면 원거리 무기의 공격력을\n조금 올릴 수 있다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#44",
     "flags": 7,
     "ko": "　레이저 사이트　＜파츠＞\n원거리 무기의 공격력과 록온 속도가\n오른다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#45",
     "flags": 7,
     "ko": "　부스트 유닛　＜파츠＞\n전투 모드에서 파워업하지만\n플라즈마가 자동으로 소비된다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#46",
     "flags": 7,
     "ko": "　리스토러 유닛　＜파츠＞\n장착하면 내구력이 자동으로\n회복된다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#47",
     "flags": 7,
     "ko": "　플라즈마 차저　＜파츠＞\n장착하면 플라즈마 미터가\n자동으로 회복된다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#48",
     "flags": 7,
     "ko": "　실드 제너레이터　＜파츠＞\n장착하면 가드력이 오른다.\n가드 시 받는 대미지가 줄어든다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#49",
     "flags": 7,
     "ko": "　아뮬렛　＜파츠＞\n장착하면 운이 크게 오른다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#50",
     "flags": 7,
     "ko": "　에너지 디튜너　＜파츠＞\n메길 상회제 커스텀 사이보그 파츠.\n좀처럼 손에 넣기 힘든 물건이라고 한다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#51",
     "flags": 7,
     "ko": "　뒷골목 진료소 열쇠　＜아이템＞\n뒷골목 진료소 문을 여는 열쇠.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#52",
     "flags": 7,
     "ko": "　또 하나의 뒷골목 진료소 열쇠　＜아이템＞\n뒷골목 진료소 문 열쇠.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#53",
     "flags": 7,
     "ko": "　기억뇌 카트리지　＜아이템＞\n뚱보의 기억뇌 카트리지.\n・・・로 생각된다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "DATA/STS_0@0#54",
     "flags": 7,
     "ko": "　유발인자　＜아이템＞\n보디를 증식 변형시키는 트리거.\n변형하면 원래 모습으로 못 돌아간다.",
     "status": "draft",
     "note": ""
    }
   ]
  }
 ]
}

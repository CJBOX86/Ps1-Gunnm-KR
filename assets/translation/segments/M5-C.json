   "lines": [
    {
     "id": "M5/C/MP445_2#0",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}뭐・・・뭐냐！이 지상인 놈！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#1",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}아직도 이런 데를 어슬렁거리고\n있었던 게냐！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#2",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}누구 없나！ＭＩＢ 머신을 불러 와 주게！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#3",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}의료 감찰국은 대체 뭘 하는 게야！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#4",
     "flags": 7,
     "ref": "M3/A/MP103_3#42"
    },
    {
     "id": "M5/C/MP445_2#5",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}의료 감찰국에 간다고요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#6",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}그럼 드디어 당신도 이니시에이션을 받고\n・・・정식 자렘 시민이 되는 거군요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#7",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}축하해요！・・・네？아니라고요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#8",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}그럼 의료 감찰국에 뭘 하러 가는 거죠？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#9",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}・・・거기는 용무가 없는 사람은・・・\n들어갈 수 없을 텐데요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#10",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}당신・・・의료 감찰국에 가는 거야？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#11",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}무슨 일이야？설마 어디 몸이라도\n안 좋아진 거야？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#12",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}별일이네・・・자렘의 완전 관리 사회에서는\n병도 부상도 거의 발생하지 않는다고 해도 될\n정도인데・・・어떻게 된 걸까？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#13",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}실은 나・・・아주 예전에 다쳐서\n의료 감찰국에 실려 간 적이 있는데・・・\n그때 나는 ５년 만의 환자였대・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/C/MP445_2#14",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}얼마나 다쳤냐고？\n・・・넘어져서 무릎이 까졌었어.",
     "status": "draft",
     "note": ""

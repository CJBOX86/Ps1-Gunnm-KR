   "lines": [
    {
     "id": "M6/C/MP715_1#0",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}으아아앗！그, 그 기술은！？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#1",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}혹시！설마！어쩌면～！？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#2",
     "flags": 7,
     "ko": "{b2}갈리：{br}화성 고무술・・・기갑술이야.\n알아？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#3",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}어, 어어～떻게 된 거예요！\n그 기술～！？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#4",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}네！네！가르쳐 줘요！\n가르쳐 주세요오～！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#5",
     "flags": 7,
     "ko": "{b2}갈리：{br}・・・그럼・・・잘 있어・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#6",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}잠깐 잠깐 기다려요～！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#7",
     "flags": 7,
     "ko": "{WS2503}{b3}남자：{br}아！인사가 늦었습니다만・・・\n저, 헤지오아 호퍼라고 하는\n사람이옵니다아！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#8",
     "flags": 7,
     "ko": "{s3}{t0}{a1}{n1}헤지오아 호퍼？\n어디서 들어 본 이름인데・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#9",
     "flags": 7,
     "ko": "{b2}갈리：{br}난 갈리・・・\n이런 곳에서 뭐 하고 있었어？\n호퍼 씨・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#10",
     "flags": 7,
     "ko": "{WS2503}{b3}호퍼：{br}잘 물어봐 주셨습니다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#11",
     "flags": 7,
     "ko": "{WS2503}{b3}호퍼：{br}저・・・\n격투기 연구가라는 기구한 장사를\n하고 있는 몸이라서요・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#12",
     "flags": 7,
     "ko": "{WS2503}{b3}호퍼：{br}기갑술 연구로 이 계곡에 와 봤더니\n・・・이, 이, 이럴 수가！\n세상에 깜짝이야！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#13",
     "flags": 7,
     "ko": "{WS2503}{b3}호퍼：{br}진짜 기갑술과 마주치고 말았다는\n그런 얘기입니다요, 네.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#14",
     "flags": 7,
     "ko": "{b2}갈리：{br}아！생각났다！\n＜기갑술의 기원＞을 쓴 호퍼 씨？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#15",
     "flags": 7,
     "ko": "{WS2503}{b3}호퍼：{br}오오！읽어 주셨습니까, 그걸！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#16",
     "flags": 7,
     "ko": "{b2}갈리：{br}격투기 연구가라면・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M6/C/MP715_1#17",
     "flags": 7,
     "ko": "{b2}갈리：{br}역시 기갑술에 대해서도・・・\n엄청 잘 알겠네？",
     "status": "draft",
     "note": ""
    },
    {

    {
     "id": "M4/K/MP202_0#0",
     "flags": 7,
     "ko": "{b5}도적：{br}오오？ 뭐여！\n넌 뭐냐아・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/K/MP202_0#1",
     "flags": 7,
     "ko": "{b5}도적：{br}이 앞은 지금 좀 바빠서 말여・・・\n못 지나가는구먼！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/K/MP202_0#2",
     "flags": 7,
     "ko": "{b2}갈리：{br}너희들・・・ 바잭이냐？",

    {
     "id": "M4/C/MP212_0#0",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}으으・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#1",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}아야야・・・참말로 험한 꼴을 당했구먼\n・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#2",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}그나저나・・・바잭인가 하는 놈들\n・・・막무가내로구먼・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#3",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}・・・열차도 탈선해 버린 모양이구먼\n・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#4",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}폭발 충격으로 이런 데까지 내동댕이쳐진\n모양이구먼・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#5",
     "flags": 7,
     "ko": "{b5}바잭：{br}헤헷！ 찾았다아！ 이런 데에도\n있었구만！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#6",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}흠！ 자네・・・바잭인가 하는\n도적인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#7",
     "flags": 7,
     "ko": "{b5}바잭：{br}팩토리에 고용된 개 따위한테\n자기소개할 필요는 없지！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#8",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}다짜고짜 덤비겠다는 겐가！ 그럼\n어쩔 수 없지・・・상대해 주겠네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#9",
     "flags": 7,
     "ko": "{s3}{t0}{a1}{n1}이・・・이런！ 렌타건이 없구먼！・・・\n어딘가에 떨어뜨린 모양이구먼！・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#10",
     "flags": 7,
     "ko": "{b5}바잭：{br}헤헷！ 왜 그래？ 총도 없는 생체\n인간이 어떻게 상대해 주겠다는 거냐아？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#11",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}훗훗훗！ 자네 따위는 맨손으로 충분\n하네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#12",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}나의 ＜대 사이버네 골법＞의 위력,\n지금 보여 주겠네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#13",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}덤벼 보게！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#14",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}뭔가？ 왜 이런 데에 데크맨이\n있는 겐가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#15",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}이게 소문으로 듣던 떠돌이 데크맨인가\n하는 놈인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#16",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}아니다쥬！ 나는 너하고 차 안에서\n한 번 만났다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#17",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}뭐야・・・그때 그 데크맨인가.\n이런 데서 뭘 하고 있는 겐가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/C/MP212_0#18",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}열차가 탈선할 때 충격으로 열차 밖으로\n튕겨 나왔다쥬！ 너하고 똑같다쥬！",
     "status": "draft",
     "note": ""
    },

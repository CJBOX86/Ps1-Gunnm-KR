   "lines": [
    {
     "id": "M3/J/MP012_4#0",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}야！좀 더 작게 말하라고！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP012_4#1",
     "flags": 7,
     "ko": "{WS2503}{b3}시민：{br}・・・그래・・・유고라면 확실히 여기\n와 있어・・・그건 그렇고, 놀랐다니까！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP012_4#2",
     "flags": 7,

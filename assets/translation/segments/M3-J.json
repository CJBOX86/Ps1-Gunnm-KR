   "lines": [
    {
     "id": "M3/J/MP011_0#0",
     "flags": 7,
     "ko": "{s3}{t7}{a1}{n1}유고 목소리가 들려・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#1",
     "flags": 7,
     "ko": "{b3}벡터：{br}그래. 그럼 이거다・・・\n대금 １０만 칩이다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#2",
     "flags": 7,
     "ko": "{b3}유고：{br}헤헤・・・매번 감사합니다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#3",
     "flags": 7,
     "ko": "{b3}벡터：{br}그나저나 요즘・・・\n꽤 의욕이 넘치는구만！유고！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#4",
     "flags": 7,
     "ko": "{b3}벡터：{br}앞으로도 그 기세로 계속 납품해\n주면, 우리로선 정말 고맙겠는데 말이야！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#5",
     "flags": 7,
     "ko": "{b3}유고：{br}그럼 또 조만간 오겠습니다！\n잘 부탁드려요・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#6",
     "flags": 7,
     "ko": "{b3}벡터：{br}어이！잠깐 기다려！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#7",
     "flags": 7,
     "ko": "{b3}벡터：{br}실은 오늘 너한테 중요한 얘기가 있었어！\n깜빡할 뻔했군！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#8",
     "flags": 7,
     "ko": "{b3}유고：{br}중요한・・・얘기・・・말인가요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#9",
     "flags": 7,
     "ko": "{b3}벡터：{br}음・・・하지만・・・\n여기선 좀 그렇군・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#10",
     "flags": 7,
     "ko": "{b3}벡터：{br}장소를 옮기지.\n네 거처에라도 가서 얘기하기로 하자.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#11",
     "flags": 7,
     "ref": "M3/C/MP005_3#19"
    },
    {
     "id": "M3/J/MP011_0#12",
     "flags": 7,
     "ko": "{b3}유고：{br}뭐！뭐야？어・・・어째서・・・\n네가 여기에！？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#13",
     "flags": 7,
     "ko": "{b2}갈리：{br}그게・・・유고를 찾다 보니까, 여기까지\n오게 돼서・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#14",
     "flags": 7,
     "ko": "{b3}벡터：{br}유고！누구냐？\n그 계집애・・・네 여자 친구라도 되냐？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#15",
     "flags": 7,
     "ko": "{b3}유고：{br}아・・・아니, 아니에요！\n그런 거 아니라고요！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#16",
     "flags": 7,
     "ko": "{b2}갈리：{br}！・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#17",
     "flags": 7,
     "ko": "{b3}유고：{br}그냥・・・좀 아는 사이라서・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#18",
     "flags": 7,
     "ko": "{b3}벡터：{br}지금까지 한 얘기・・・\n설마 엿들은 건 아니겠지？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#19",
     "flags": 7,
     "ko": "{b3}유고：{br}괘・・・괜찮아요・・・\n이 녀석은 아마 무슨 뜻인지 모를 거예요・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#20",
     "flags": 7,
     "ko": "{b3}유고：{br}야・・・\n이런 데까지 쫓아오지 마・・・{page}할 말 있으면, 다음에 들어 줄 테니까・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#21",
     "flags": 7,
     "ko": "{b2}갈리：{br}저기！아저씨！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#22",
     "flags": 7,
     "ko": "{b3}유고：{br}바・・・바보, 그만둬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#23",
     "flags": 7,
     "ko": "{b2}갈리：{br}듣자 하니 뒷골목 브로커를\n한다던데・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#24",
     "flags": 7,
     "ko": "{b2}갈리：{br}만약 유고를 그런 나쁜 세계로\n끌어들이기라도 하면・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#25",
     "flags": 7,
     "ko": "{b2}갈리：{br}하느님이 용서해도, 이 갈리가\n용서 안 할 거야！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#26",
     "flags": 7,
     "ko": "{b3}벡터：{br}가자！유고！빨리 해・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#27",
     "flags": 7,
     "ko": "{b3}유고：{br}네・・・넷！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#28",
     "flags": 7,
     "ko": "{b3}유고：{br}너도 빨리 돌아가・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#29",
     "flags": 7,
     "ko": "{s3}{t7}{a1}{n1}뭐야！유고 녀석・・・\n난 유고 여자 친구도 아니지만・・・{page}{s3}{t7}{a1}{n1}그렇게 세게 부정할 건 없잖아！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/J/MP011_0#30",
     "flags": 7,
     "ko": "{s3}{t7}{a1}{n1}그나저나・・・왠지 걱정되네・・・{page}{s3}{t7}{a1}{n1}유고는 왜 그런 뒷골목 브로커랑\n관계를 맺고 있는 걸까？",
     "status": "draft",
     "note": ""
    }
   ]
  },
  {
   "id": "M3/J/MP012_1",

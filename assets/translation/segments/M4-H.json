   "lines": [
    {
     "id": "M4/H/MP241_2#0",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}베이비！ 살아 있었냐쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#1",
     "flags": 7,
     "ko": "{b2}갈리：{br}넌・・・ 분명, 바잭의 포로가\n돼 있던・・・？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#2",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}그렇다쥬！ 베이비와 함께\n감금돼 있던 데크맨이다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#3",
     "flags": 7,
     "ko": "{b2}갈리：{br}그 상황에서 용케 살아났네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#4",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}운이 좋았다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#5",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}그나저나・・・ 베이비야말로\n용케 무사했다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#6",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}베이비가 반란을 일으킨\n너클헤드에게 끌려갔을 때는・・・\n이제 살아날 수 없을 거라 생각했다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#7",
     "flags": 7,
     "ko": "{b2}갈리：{br}응！ 위험할 때 퍼기어가\n구하러 와 줬거든.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#8",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}퍼기어？ 아아・・・ 그 머리띠를\n두른 근육질 형씨 말이냐쥬？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#9",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}생체 보디인 주제에 바잭의\n소켓병을 차례차례 쓰러뜨렸다쥬・・・\n그 남자, 보통 놈이 아니다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#10",
     "flags": 7,
     "ko": "{b2}갈리：{br}응！ 정말 대단한 녀석이야！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#11",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}베이비・・・ 왠지 얼굴이 빨갛다쥬！\n혹시 그 남자, 베이비의 애인이냐쥬？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#12",
     "flags": 7,
     "ko": "{b2}갈리：{br}화끈・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#13",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}으음～・・・ 러브러브다쥬！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#14",
     "flags": 7,
     "ko": "{b2}갈리：{br}그・・・ 그것보다・・・ 설명해 줘！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#15",
     "flags": 7,
     "ko": "{b2}갈리：{br}대체 뭐야？ 이 근처에 출현하고 있는\n기묘한 몬스터들은・・・？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#16",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}모르겠다쥬・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#17",
     "flags": 7,
     "ko": "{WS2503}{b3}데크맨：{br}다만・・・ 아주 옛날부터\n＜ＵＭＡ（유마）＞라 불리는 미확인 생물이\n세계 곳곳에서 목격됐던 모양이다쥬.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/H/MP241_2#18",

    {
     "id": "M4/A/MP208_1#0",
     "flags": 7,
     "ko": "{b3}용병：{br}에헤헤・・・가, 강하네・・・당신・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#1",
     "flags": 7,
     "ko": "{b2}남자：{br}뭔가. 다른 사람도 있었구먼.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#2",
     "flags": 7,
     "ko": "{b3}용병：{br}맨손으로 사이보그를 때려눕히는 인간은\n・・・처, 처음 봤어・・・에헤헤・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#3",
     "flags": 7,
     "ko": "{b3}용병：{br}주・・・죽여 버린 거야？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#4",
     "flags": 7,
     "ko": "{b2}남자：{br}뭘. 가벼운 뇌진탕을 일으켰을 뿐일세.\n곧 정신을 차리겠지.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#5",
     "flags": 7,
     "ko": "{b2}남자：{br}그런데 자네도 용병인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#6",
     "flags": 7,
     "ko": "{b3}용병：{br}뭐, 뭐든지 물어봐. 당신 용병 처음\n이지？ 나, 난 요르그라고 해.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_1#7",
     "flags": 7,
     "ko": "{b2}남자：{br}나는 퍼기어・・・퍼기어 포어일세！",
     "status": "draft",
     "note": ""
    }
   ]
  },
  {

   "lines": [
    {
     "id": "M4/A/MP208_2#0",
     "flags": 7,
     "ko": "{b3}용병：{br}아・・・아직 무슨 볼일이라도\n있으신 겁니까요？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_2#1",
     "flags": 7,
     "ko": "{b3}용병：{br}아・・・아까는 잘못했습니다요.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_2#2",
     "flags": 7,
     "ko": "{b3}용병：{br}네놈이 엄청 세다는 건・・・뼈저리게\n알았습니다요.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_2#3",
     "flags": 7,
     "ko": "{b3}용병：{br}앞으로 예의는 츠, 충분히 조심할\n테니・・・제발 좀 봐주셨으면 합니다요・・・？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_2#4",
     "flags": 7,
     "ko": "{b3}용병：{br}서로 같은 열차 용병끼리・・・지난 일은\n물에 흘려보내고 사이좋게 지내십시다요・・・",
     "status": "draft",
     "note": ""
    }
   ]
  },

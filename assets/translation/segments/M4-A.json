   "lines": [
    {
     "id": "M4/A/MP209_0#0",
     "flags": 7,
     "ko": "{b3}요르그：{br}이・・・이렇게 하고・・・이제 됐다.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#1",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}오！ 겨우 몸에 맞는구먼！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#2",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}고맙네・・・계속 자리가 안 잡혀서\n불편했다네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#3",
     "flags": 7,
     "ko": "{b3}요르그：{br}벼, 별거 아냐.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#4",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}그나저나 이 장비에는 손들었구먼.\n등 긁는 것도 한 고생일세・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#5",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}볼일 볼 때도 거치적거리고・・・어떻게\n못 떼어 내겠나？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#6",
     "flags": 7,
     "ko": "{b3}요르그：{br}개, 개 목걸이랑 똑같아. 렌타건은\n계약 기간 중엔 절대로 안 빠져.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#7",
     "flags": 7,
     "ko": "{b3}요르그：{br}억, 억지로 떼려고 하거나 열차에서\n탈주하면 목이 펑！ 하고 날아가는 장치야.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#8",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}가혹하구먼・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#9",
     "flags": 7,
     "ko": "{b3}요르그：{br}그, 그런데 당신은 왜 이\n팩토리 철도 용병에 지원한 거야？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#10",
     "flags": 7,
     "ko": "{WS2503}{b2}퍼기어：{br}뭘. 그냥 ２주에 ２０만 칩이라는\n파격적인 보수에 끌렸을 뿐일세.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#11",
     "flags": 7,
     "ko": "{WS2503}{b2}퍼기어：{br}고철마을 같은 도시의 콤비나트\n노동자도・・・한 달을 꼬박 일해 봤자\n１０만 칩 남짓한 월급이라네・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#12",
     "flags": 7,
     "ko": "{WS2503}{b2}퍼기어：{br}그런데 이 용병 일은 ２주 동안\n열차에 흔들리기만 하면・・・\n그 두 배의 칩을 벌 수 있으니 말일세！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#13",
     "flags": 7,
     "ko": "{WS2503}{b2}퍼기어：{br}이렇게 짭짤한 일은 없다 싶어서\n당장 계약했다네！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#14",
     "flags": 7,
     "ko": "{WS2503}{b2}퍼기어：{br}계약 기간이 끝나고 ２０만 칩을\n받을 날이・・・벌써부터 기대되는구먼！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#15",
     "flags": 7,
     "ko": "{b3}요르그：{br}＜바, 바잭＞ 소문 못 들었어？\n이, ２０만으론 수지가 안 맞는 일이라고？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#16",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}열차를 통째로 훔쳤다던가 하는 도적\n말인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#17",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}그렇게 위험한 놈들인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#18",
     "flags": 7,
     "ko": "{b3}요르그：{br}이, 이번 달 들어 열차 ５대가\n호위 용병단째로 전멸당했다던데・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#19",
     "flags": 7,
     "ko": "{b3}요르그：{br}그, 그게 전부 바잭 짓이라나 봐\n・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#20",
     "flags": 7,
     "ko": "{b2}퍼기어：{br}・・・흐～음.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#21",
     "flags": 7,
     "ko": "{WS2503}{b3}요르그：{br}지, 진짜라니까・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#22",
     "flags": 7,
     "ko": "{WS2503}{b3}요르그：{br}이, 이 팩토리 철도는\n팩토리 직할 농장＜팜＞이나 자원 채굴장을\n팩토리와 잇는 화물 전용 철도라서,{page}당연히 팩토리 물자를 싣고 있어.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#23",
     "flags": 7,
     "ko": "{WS2503}{b3}요르그：{br}그, 그래서 예전엔 도적단도 팩토리를\n적으로 돌려 봤자 승산이 없다고 해서\n거의 손을 안 댔던 모양인데・・・{page}바잭 놈들은 그런 거 상관없이\n습격해 온대.",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#24",
     "flags": 7,
     "ko": "{WS2503}{b3}요르그：{br}요, 요즘엔 각지에 흩어진 농장에까지\n손을 대기 시작해서, 벌써 몇 군데는\n점령당했다는 얘기도 들었어・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP209_0#25",
     "flags": 7,

   "lines": [
    {
     "id": "M4/A/MP208_0#0",
     "flags": 7,
     "ko": "{b2}남자：{br}이보게！ 따분하구먼！\n얘기라도 좀 하지 않겠나？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#1",
     "flags": 7,
     "ko": "{b5}용병：{br}・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#2",
     "flags": 7,
     "ko": "{b2}남자：{br}보아하니 완전 사이보그 같은데, 고철마을\n출신인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#3",
     "flags": 7,
     "ko": "{b2}남자：{br}말수 없는 녀석이구먼！ 그런데 이\n렌타건, 어떻게 좀 안 되겠나？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#4",
     "flags": 7,
     "ko": "{b2}남자：{br}영 몸에 안 맞는구먼・・・튀어나온 데가\n등에 닿아서 불편한데・・・{page}좀 봐 주지 않겠나？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#5",
     "flags": 7,
     "ko": "{b5}용병：{br}이제 고쳐졌냐아？ 시끄러우니까 저리\n꺼져！ 이 촌뜨기 자식아！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#6",
     "flags": 7,
     "ko": "{b2}남자：{br}자네・・・고철마을 출신인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#7",
     "flags": 7,
     "ko": "{b5}용병：{br}뭐어？ 그게 어쨌다는 거냐？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#8",
     "flags": 7,
     "ko": "{b2}남자：{br}・・・하여간 도시 사이보그 놈들은\n부모한테 버릇을 못 배웠구먼！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#9",
     "flags": 7,
     "ko": "{b2}남자：{br}다짜고짜 사람을 쳐서 넘어뜨리는\n무례한 놈은 혼 좀 나야겠구먼～！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#10",
     "flags": 7,
     "ko": "{b5}용병：{br}게하하！ 너 제정신이냐！？ 생체 맨몸\n녀석 주제에 완전 사이보그인 나랑 붙겠다고！？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#11",
     "flags": 7,
     "ko": "{b5}용병：{br}재밌군！ 심심하던 참인데 좀 놀아 주지！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#12",
     "flags": 7,
     "ko": "{b5}용병：{br}그렇게 내 주먹맛이 보고 싶다면\n보여 주마！！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M4/A/MP208_0#13",
     "flags": 7,
     "ko": "{b2}남자：{br}정말이지 버르장머리 없는 녀석이구먼！",
     "status": "draft",
     "note": ""
    }
   ]
  },

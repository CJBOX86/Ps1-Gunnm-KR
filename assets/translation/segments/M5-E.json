    {
     "id": "M5/E/MP430_0#0",
     "flags": 7,
     "ko": "{WS2503}{b5}ＭＩＢ 머신：{br}여기는 의료 감찰국・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#1",
     "flags": 7,
     "ko": "{WS2503}{b5}ＭＩＢ 머신：{br}부상자・・・이니시에이션을\n받는 자・・・및 ＭＩＢ 머신이 인도하는 자\n이외의 출입은・・・엄격히 금지되어 있다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#2",
     "flags": 7,
     "ko": "{WS2503}{b5}ＭＩＢ 머신：{br}즉각・・・이 장소를 떠날 것！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#3",
     "flags": 7,
     "ko": "{b2}갈리：{br}그렇군！\n이니시에이션 룸은・・・이 안이겠지？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#4",
     "flags": 7,
     "ko": "{b2}갈리：{br}지나가게 해 줄래？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#5",
     "flags": 7,
     "ko": "{WS2503}{b5}ＭＩＢ 머신：{br}이 개체는 성인이면서・・・\n이니시에이션을 받지 않았다・・・\n시민 실격자다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#6",
     "flags": 7,
     "ko": "{WS2503}{b5}ＭＩＢ 머신：{br}따라서！\n즉시・・・이 개체를 말소한다！",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#7",
     "flags": 7,
     "ko": "{b2}갈리：{br}・・・안 열려・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#8",
     "flags": 7,
     "ko": "{b2}갈리：{br}아무래도・・・폐쇄된 것 같네・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#9",
     "flags": 7,
     "ko": "{b2}갈리：{br}이 문 너머에 이니시에이션 룸으로\n가는 통로가 있을 것 같은데・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#10",
     "flags": 7,
     "ko": "{b2}갈리：{br}곤란한데・・・어쩌지？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#11",
     "flags": 7,
     "ko": "{b2}갈리：{br}・・・안 열려・・・\n역시 폐쇄된 모양이야・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#12",
     "flags": 7,
     "ko": "{b2}갈리：{br}・・・이건・・・비상구 같은 문인가？",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#13",
     "flags": 7,
     "ko": "{b2}갈리：{br}아무래도 여긴 폐쇄되지 않은\n것 같아・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M5/E/MP430_0#14",
     "flags": 7,
     "ko": "{b2}갈리：{br}이쪽으로 가서 어떻게든 이니시에이션\n룸까지 갈 수 없을까？",
     "status": "draft",
     "note": ""
    }
   ]

     "note": ""
    },
    {
     "id": "M4/G/MP201_0#7",
     "flags": 7,
     "ko": "{b5}ＧＲ－２：{br}이 녀석은 날 모조품이라고\n부르는데・・・",
     "status": "draft",
     "note": ""

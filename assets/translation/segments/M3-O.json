    {
     "id": "M3/O/MP290_0#2",
     "flags": 7,
     "ko": "{b2}갈리：{br}어떻게 된 거지？ 나・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/O/MP290_0#3",
     "flags": 7,
     "ko": "{b2}갈리：{br}뭐, 됐어・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/O/MP290_0#4",
     "flags": 7,
     "ko": "{b2}갈리：{br}분명 꿈이라도 꾼 거야・・・",
     "status": "draft",
     "note": ""
    },
    {
     "id": "M3/O/MP290_0#5",
     "flags": 7,
     "ko": "{BKC333}{FRC1}{b3}남자：{br}여어・・・",
